# Copy this file to .env and fill in your credentials.

# ── Topstep / ProjectX API ──
TOPSTEP_USERNAME=your@email.com
TOPSTEP_API_KEY=your_api_key_here
TOPSTEP_ACCOUNT_ID=your_account_id
TOPSTEP_BASE_URL=https://api.topstepx.com
TOPSTEP_RTC_URL=https://rtc.topstepx.com

# ── Telegram ──
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
# Optional: extra NUMERIC chat IDs (comma-separated) that get ONLY the /hub link.
# Each must have started the bot first; a @handle won't work. e.g. 123456789,987654321
TELEGRAM_HUB_RECIPIENTS=

# ── Web UI ──
UI_HOST=127.0.0.1
UI_PORT=8000
# On launch, auto-raise a public cloudflared link, open it in the browser, and send
# it via Telegram (to you + TELEGRAM_HUB_RECIPIENTS). Set to 0 for localhost only.
AUTO_HUB=1
# On launch, retroactively score bars missing a signal (e.g. captured while stopped).
# Only gaps are filled; live/static signals are never rewritten. Set to 0 to disable.
BACKFILL_ON_START=1

# ── Execution / trade sizing ──
# Max dollar risk per trade; dynamic micro (MNQ/MES) sizing keeps each trade <= this.
MAX_RISK_PER_TRADE=200

# ── Logging ──
LOG_LEVEL=INFO
